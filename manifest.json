{
  "name": "파일 업로드",
  "short_name": "파일업로드",
  "description": "비밀키로 보호되는 개인 파일 업로드 서비스",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#f7f3ef",
  "theme_color": "#f2a7b8",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "image/*",
            "video/*",
            "application/*",
            "*/*"
          ]
        }
      ]
    }
  },
  "scope": "./"
}